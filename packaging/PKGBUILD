# Maintainer: marvelxcodes <ramakrishnan0046@gmail.com>
#
# Builds the checkout this file lives in, so run makepkg from packaging/ with the
# sibling path dependencies checked out next to the repository, as
# .github/workflows/package.yml does: ../crownos-voice, ../crownos-ipc,
# ../crownos-config and ../crownui (plus whatever those path-depend on).

pkgname=crownos-sound-recorder
pkgver=0.1.1
pkgrel=1
pkgdesc="Voice recorder for CrownOS"
arch=(x86_64)
url="https://github.com/Crown-OS/crownos-sound-recorder"
license=('MIT OR Apache-2.0')
depends=(ffmpeg pipewire glibc gcc-libs wayland libxkbcommon vulkan-icd-loader)
optdepends=("crownos-voice: AI noise suppression and Enhance")
makedepends=(cargo clang)
options=(!lto !debug)

_workspace="$startdir/.."

prepare() {
  cd "$_workspace"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_workspace"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --frozen --bin "$pkgname"
}

package() {
  install -Dm755 "$srcdir/target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm644 "$_workspace/data/$pkgname.desktop" -t "$pkgdir/usr/share/applications"
  install -Dm644 "$_workspace/data/org.crownos.SoundRecorder.metainfo.xml" -t "$pkgdir/usr/share/metainfo"
  install -Dm644 "$_workspace"/LICENSE-{MIT,APACHE} -t "$pkgdir/usr/share/licenses/$pkgname"
}
